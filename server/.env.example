# Copy to .env and fill in values.

PORT=3001

# Comma-separated origins allowed for CORS (browser). Vite default:
CORS_ORIGIN=http://localhost:5173

# Spotify — https://developer.spotify.com/dashboard
# Client Credentials flow (no user login; public catalog only).
# Paste ID and secret without quotes; stray spaces/newlines break auth (values are trimmed on read).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: enable GET /api/spotify/ping when NODE_ENV=production (diagnose HTTP 403; no secrets returned).
# SPOTIFY_DEBUG=1

# Optional: artist id for GET /api/spotify/artist/tracks (albums + singles; public catalog).
# From https://open.spotify.com/artist/<THIS_PART> — paste URL or raw id.
SPOTIFY_ARTIST_ID=

# If GET …/top-tracks returns HTTP 403 (common for Spotify apps in Development mode since Nov 2024),
# list raw track ids or full open.spotify.com/track/… URLs (comma/newline separated, max 50).
# Used as fallback via GET /tracks — still works for many apps when top-tracks does not.
# SPOTIFY_TOP_TRACK_IDS=https://open.spotify.com/track/abc...,https://open.spotify.com/track/def...

# Optional: ISO 3166-1 alpha-2 only (two letters, e.g. US). Not full country names.
# Used for Spotify market/locale on several routes. Invalid values fall back to US.
# SPOTIFY_MARKET=US

# Optional: min gap after EVERY Spotify Web API GET (serialized queue). Primary defense against HTTP 429. Default 120ms.
# Set to 0 only if one request at a time is guaranteed (SPOTIFY_CATALOG_GAP_MS can supplement).
# SPOTIFY_REQUEST_MIN_GAP_MS=120

# Optional: extra milliseconds after each catalog-specific call only (additive to SPOTIFY_REQUEST_MIN_GAP_MS). Default 0.
# SPOTIFY_CATALOG_GAP_MS=0

# Optional: catalog JSON cache TTL (ms). Successful builds are reused to avoid long waits / rate limits on refresh.
# Default 300000 (5 min). Set to 0 to disable.
# SPOTIFY_CATALOG_CACHE_MS=300000

# Optional: abort Spotify API HTTP requests after this many ms (prevents indefinite hangs). Default 45000.
# SPOTIFY_FETCH_TIMEOUT_MS=45000

# Optional: max wait (ms) when honoring Spotify HTTP 429 Retry-After. Default 90000. Avoid setting low (e.g. 25000):
# retries before Spotify’s window expires cause repeated 429s.
# SPOTIFY_RETRY_AFTER_MAX_MS=90000

# SoundCloud — https://developers.soundcloud.com/
# OAuth 2.1 client credentials (server-side).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# PKCE + authorization code: must match the redirect URI in your SoundCloud app exactly.
# Default if unset: http://localhost:PORT/api/soundcloud/auth/callback
# Flow: open GET /api/soundcloud/auth/start → then SoundCloud sends user back here with ?code.
SOUNDCLOUD_REDIRECT_URI=

# Optional: where to store OAuth user tokens (default: server/.soundcloud-user-tokens.json).
# On Fly.io, point this at a file on a mounted volume so refresh survives deploys.
# SOUNDCLOUD_USER_TOKEN_FILE=/data/soundcloud-user-tokens.json

# Optional: override user access token. Normally omitted — after one visit to
# /api/soundcloud/auth/start, tokens live on disk (see above). Use if you cannot persist a file.
SOUNDCLOUD_USER_ACCESS_TOKEN=
